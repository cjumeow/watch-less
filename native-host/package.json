{
  "name": "@yt-digest/native-host",
  "version": "0.1.0",
  "private": true,
  "description": "The Native Messaging host Chrome starts for each request: it checks the request and writes it to the queue.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/host.js"
  },
  "dependencies": {
    "@yt-digest/shared": "0.1.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
