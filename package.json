{
  "name": "yt-digest",
  "version": "0.0.0",
  "private": true,
  "description": "Turn a YouTube video into a neutral, evidence-backed summary in Heptabase, from a button on its thumbnail.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "shared",
    "extension",
    "worker",
    "native-host"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces && tsc -p e2e",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run test:e2e",
    "test:e2e": "playwright test -c e2e",
    "setup": "sh scripts/setup.sh",
    "install-local": "sh scripts/install-local.sh",
    "prepare": "git rev-parse --git-dir > /dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
