{
  "manifest_version": 3,
  "name": "yt-digest",
  "version": "0.0.0",
  "description": "A button on YouTube thumbnails that requests a digest of the video from yt-digest on this computer.",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["nativeMessaging"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["page.css"],
      "run_at": "document_idle"
    }
  ]
}
